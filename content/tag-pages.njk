---js
// <script>
const pagination = {
	data: "collections",
	size: 1,
	alias: "tag",
	filter: ["all", "posts"],
	// addAllPagesToCollections: true,
};

const eleventyExcludeFromCollections = true;

const eleventyComputed = {
	title: data => `${data.tag} | Dan Munz`,
	description: data => `Browse Dan Munz’s writing on ${data.tag}.`,
	permalink: function(data) {
		return this.tagUrl(data.tag);
	}
};
---
<h1 id="tagged-{{ tag | slugify }}">Topic: {{ tag }}</h1>

{% set postslist = collections[ tag ] %}
{% set postlistHeadingLevel = 2 %}
{% include "postslist.njk" %}

<p>See <a href="/tags/">all topics</a>.</p>
