
{% set legacyDateIds = [] %}
<ol reversed class="postlist" style="--postlist-index: {{ (postslistCounter or postslist.length) + 1 }}">
{%- for post in postslist | reverse %}
	{% set legacyDateId = "post-" + (post.date | readableDate("ddLLyyyy")) %}
	<li class="postlist-item{% if post.url == url %} postlist-item-active{% endif %}" id="{{ post.url | postListId }}">
		{# Preserve old date fragments once per date, at the first displayed matching post. #}
		{% if legacyDateIds.indexOf(legacyDateId) == -1 %}
		<span id="{{ legacyDateId }}"></span>
		{% set legacyDateIds = legacyDateIds.concat([legacyDateId]) %}
		{% endif %}
		<time class="postlist-date" datetime="{{ post.date | htmlDateString }}">{{ post.date | readableDate("LLLL d, yyyy") }}</time>
		<h{{ postlistHeadingLevel }} class="postlist-title"><a href="{{ post.url }}" class="postlist-link">{% if post.data.title %}{{ post.data.title }}{% else %}<code>{{ post.url }}</code>{% endif %}</a></h{{ postlistHeadingLevel }}>
		<span class="postlist-desc">{{ post.data.description }}</span>
	</li>
{%- endfor %}
</ol>
