<!doctype html>
<html lang="{{ metadata.language }}">
	<head>





		<meta charset="utf-8">
		<meta name="viewport" content="width=device-width, initial-scale=1.0">
		
{%- set previewTitle = title or metadata.title %}
{%- set previewDescription = description or metadata.description %}
		<title>{{ previewTitle | escape }}</title>
		<meta name="description" content="{{ previewDescription | escape }}">
		{% if page.url == "/404.html" %}
		<meta name="robots" content="noindex">
		{% elif pageUrls.canonicalUrl %}
		<link rel="canonical" href="{{ pageUrls.canonicalUrl | escape }}">
		{% endif %}
		<meta property="og:title" content="{{ previewTitle | escape }}">
		<meta property="og:description" content="{{ previewDescription | escape }}">
		<meta property="og:type" content="{{ socialType or 'website' }}">
		{% if pageUrls.publicUrl %}
		<meta property="og:url" content="{{ pageUrls.publicUrl | escape }}">
		{% endif %}
		<meta name="twitter:title" content="{{ previewTitle | escape }}">
		<meta name="twitter:description" content="{{ previewDescription | escape }}">

<meta property="og:image" content="{{ resolvedSocialImage }}" />
<meta property="og:image:secure_url" content="{{ resolvedSocialImage }}" />
<meta name="twitter:image" content="{{ resolvedSocialImage }}" />


<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:type" content="image/png" />
<meta name="twitter:card" content="summary_large_image">



		
		
		
		<link rel="alternate" href="/feed/feed.xml" type="application/atom+xml" title="{{ metadata.title }}">
		

		<link rel="me" href="https://github.com/danmunz" />
		<link rel="me" href="https://www.linkedin.com/in/danmunz/" />
		<link rel="me" href="https://bsky.app/profile/danmunz.bsky.social/" />

		<meta name="generator" content="{{ eleventy.generator }}">

		{% css %}
		{{ fontCss | safe }}
		{% include "css/index.css" %}
		{% include "css/prism-custom-theme.css" %}
		{% endcss %}
		<link rel="stylesheet" href="{% getBundleFileUrl "css" %}">
		<script type="module">{% include "node_modules/@zachleat/heading-anchors/heading-anchors.js" %}</script>
		


	</head>


<!-- Google tag (gtag.js) -->
<script async src="https://www.googletagmanager.com/gtag/js?id=G-PM95BS3TNB"></script>
<script>
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('js', new Date());

  gtag('config', 'G-PM95BS3TNB');
</script>


	<body>
					
		<a href="#main" id="skip-link" class="visually-hidden">Skip to main content</a>

		<header>
			<a href="/" class="home-link">{{ metadata.title }}</a>

			{#- Read more about `eleventy-navigation` at https://www.11ty.dev/docs/plugins/navigation/ #}
			<nav>
				<h2 class="visually-hidden">Top level navigation menu</h2>
				<ul class="nav">
				{%- for entry in collections.all | eleventyNavigation %}
					<li class="nav-item"><a href="{{ entry.url }}"{% if entry.url == page.url %} aria-current="page"{% endif %}>{{ entry.title }}</a></li>
				{%- endfor %}
				</ul>
			</nav>
		</header>

		<main id="main">
			<heading-anchors>
				{{ content | safe }}

			</heading-anchors>
		</main>

		<footer>
			<p center>
				Built with <a href="https://www.11ty.dev/">{{ eleventy.generator }}</a>. Full colophon <a href="/about/#colophon">here</a>.
			</p>
		</footer>

		<!-- This page `{{ page.url }}` was built on {% currentBuildDate %} -->
		<script>
			function selectCopySource(source) {
				try {
					const selection = window.getSelection();
					if (!selection) return false;
					const range = document.createRange();
					range.selectNodeContents(source);
					selection.removeAllRanges();
					selection.addRange(range);
					return !selection.isCollapsed;
				} catch {
					return false;
				}
			}

			document.querySelectorAll("pre > code, blockquote[data-copy-prompt]").forEach((source, index) => {
				const block = source.closest("pre") || source;
				const language = [...source.classList, ...block.classList].find(name => name.startsWith("language-"))?.slice(9);
				const promptLabel = source.dataset.copyPrompt;
				const isPrompt = promptLabel !== undefined || language === "prompt";
				const isText = language === "text" || language === "plaintext";
				const label = isPrompt ? "Copy prompt" : isText ? "Copy text" : "Copy code";
				const context = promptLabel || `${language ? `${language} ` : ""}block ${index + 1}`;

				const controls = document.createElement("div");
				controls.className = "copy-controls";
				const button = document.createElement("button");
				button.type = "button";
				button.className = "copy-button";
				button.textContent = label;
				button.setAttribute("aria-label", `${label} (${context})`);
				const status = document.createElement("span");
				status.className = "copy-status";
				status.setAttribute("role", "status");
				controls.append(button, status);
				block.before(controls);

				let copying = false;
				button.addEventListener("click", async () => {
					if (copying) return;
					copying = true;
					button.setAttribute("aria-disabled", "true");
					status.textContent = "Copying…";
					const paragraphs = source.querySelectorAll(":scope > p");
					const text = paragraphs.length
						? [...paragraphs].map(paragraph => paragraph.textContent.trim()).join("\n\n")
						: source.textContent;
					try {
						await navigator.clipboard.writeText(text);
						status.textContent = "Copied.";
					} catch {
						status.textContent = selectCopySource(source)
							? "Text selected. Use your device’s copy command."
							: "Select the text and use your device’s copy command.";
					} finally {
						copying = false;
						button.removeAttribute("aria-disabled");
					}
				});
			});
		</script>
		<script type="module" src="{% getBundleFileUrl "js" %}"></script>
	</body>
</html>
